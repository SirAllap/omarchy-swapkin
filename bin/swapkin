#!/usr/bin/env bash
# Multi-provider account switcher. The engine (this file) knows accounts,
# colours, storage layout, demo mode and dispatch; each provider's own
# behaviour (how a login is stored, how a switch works, how usage is probed)
# lives in bin/providers/<id>.sh and is sourced in behind a small contract.
#
# Claude keeps its original, unchanged layout ($ACCOUNTS/<name>/, $ACCOUNTS/active)
# because it is live and cannot be migrated. Every other provider lives under
# $ACCOUNTS/providers/<id>/.
set -euo pipefail
shopt -s nullglob
umask 077

SCRIPT_DIR="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
PROVIDERS_DIR="$SCRIPT_DIR/providers"
REPO_ROOT="$(dirname "$SCRIPT_DIR")"

ACCOUNTS="${SWAPKIN_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/swapkin}"

die() { echo "swapkin: $*" >&2; exit 1; }
pause() { [[ -t 0 ]] && read -rsn 1 -p "Press any key to close. " && echo || true; }
fail() { echo "swapkin: $*" >&2; pause; exit 1; }

# A floating terminal starts from a bare environment, so a CLI installed by a
# version manager (mise, asdf, nvm, volta) is not on PATH yet. Find it anyway.
tool_bin() { # name
  local name="$1" candidate
  # L4: name can come from a custom provider's config `command` field. A
  # value like "x; rm -rf ~" must never reach a shell as unquoted text.
  [[ $name =~ ^[A-Za-z0-9._-]+$ ]] || return 1
  if candidate=$(command -v "$name" 2>/dev/null); then echo "$candidate"; return; fi
  for candidate in "$HOME/.local/share/mise/shims/$name" "$HOME/.local/bin/$name" \
                   "$HOME/.asdf/shims/$name" "$HOME/.volta/bin/$name" \
                   "/usr/local/bin/$name" "/usr/bin/$name"; do
    [[ -x $candidate ]] && { echo "$candidate"; return; }
  done
  candidate=$(bash -lc "command -v $(printf '%q' "$name")" 2>/dev/null || true)
  [[ -n $candidate ]] && echo "$candidate"
}

valid_name() {
  [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]] || die "account names use a-z, 0-9, - and _ (for example: work, personal)"
  # 'providers' is reserved (it is the folder every non-Claude provider lives
  # under); a name starting with '.' is already blocked by the regex above,
  # since it requires an a-z0-9 first character.
  [[ $1 == providers ]] && die "'providers' is a reserved name"
  return 0
}
valid_colour() { [[ $1 =~ ^#[0-9a-fA-F]{6}$ ]] || die "colours look like #7fa7d9"; }
valid_provider_id() { [[ $1 =~ ^[a-z0-9][a-z0-9_-]{0,31}$ ]]; }

# Write through a temp file in the same folder, so the target gets a fresh mtime atomically.
replace() { # file jq-filter [jq args...]
  local file="$1" filter="$2"; shift 2
  local tmp; tmp=$(mktemp "$file.XXXXXX")
  jq "$@" "$filter" "$file" > "$tmp"
  chmod --reference="$file" "$tmp"
  mv "$tmp" "$file"
}

# Each account carries a colour so it is recognisable at a glance in the bar
# and the list. Palette first; past that, a colour derived from the name.
PALETTE=("#7fa7d9" "#d97757" "#8fb572" "#d9a54a" "#b98fd9" "#6fc7c0" "#d98fa8" "#a8a35c" "#7f8fd9" "#c98f6f")

derived_colour() { # seed
  local hash hue
  hash=$(printf '%s' "$1" | cksum | cut -d' ' -f1)
  hue=$((hash % 360))
  awk -v h="$hue" 'BEGIN{
    s=0.42; l=0.66; c=(1-((2*l)-1<0?-((2*l)-1):((2*l)-1)))*s; x=c*(1-(((h/60)%2)-1<0?-(((h/60)%2)-1):(((h/60)%2)-1))); m=l-c/2;
    if(h<60){r=c;g=x;b=0}else if(h<120){r=x;g=c;b=0}else if(h<180){r=0;g=c;b=x}
    else if(h<240){r=0;g=x;b=c}else if(h<300){r=x;g=0;b=c}else{r=c;g=0;b=x}
    printf "#%02x%02x%02x", (r+m)*255, (g+m)*255, (b+m)*255}'
}

# Where a provider's accounts live. Claude keeps today's layout; everyone else
# gets a folder under providers/.
provider_root() { # id
  [[ $1 == claude ]] && echo "$ACCOUNTS" || echo "$ACCOUNTS/providers/$1"
}
provider_active_file() { echo "$(provider_root "$1")/active"; } # id

eng_profiles() { # id marker
  local root="$1" dir
  root=$(provider_root "$1")
  local marker="$2"
  for dir in "$root"/*/; do
    [[ -f $dir/$marker ]] && basename "$dir"
  done
}

colour_of_id() { jq -r '.colour // empty' "$(provider_root "$1")/$2/meta.json" 2>/dev/null || true; } # id name

colour_taken_id() { # id marker colour ignore
  local id="$1" marker="$2" colour="$3" ignore="${4:-}" name
  for name in $(eng_profiles "$id" "$marker"); do
    [[ $name == "$ignore" ]] && continue
    [[ $(colour_of_id "$id" "$name") == "$colour" ]] && return 0
  done
  return 1
}

next_colour_id() { # id marker seed
  local id="$1" marker="$2" c
  for c in "${PALETTE[@]}"; do
    colour_taken_id "$id" "$marker" "$c" || { echo "$c"; return; }
  done
  derived_colour "${3:-$RANDOM}"
}

set_colour_id() { # id marker name colour
  valid_name "$3"
  valid_colour "$4"
  local dir; dir="$(provider_root "$1")/$3"
  [[ -d $dir ]] || die "no account named '$3'"
  colour_taken_id "$1" "$2" "$4" "$3" && die "another account already uses $4"
  jq -n --arg c "$4" '{colour: $c}' > "$dir/meta.json.tmp"
  mv "$dir/meta.json.tmp" "$dir/meta.json"
}

# --- convenience wrappers for whichever provider is currently loaded (P_ID/P_MARKER) ---
profiles() { eng_profiles "$P_ID" "$P_MARKER"; }
# An adapter may define p_active to work out the active account by asking
# the tool itself (copilot: gh's real active login) rather than trusting
# swapkin's own stored pointer, which can drift when the tool is switched
# by hand (M9). Falls back to the stored pointer when it doesn't.
active() {
  if declare -F p_active >/dev/null; then p_active; return; fi
  cat "$(provider_active_file "$P_ID")" 2>/dev/null || true
}
colour_of() { colour_of_id "$P_ID" "$1"; }
next_colour() { next_colour_id "$P_ID" "$P_MARKER" "${1:-$RANDOM}"; }
set_colour() { set_colour_id "$P_ID" "$P_MARKER" "$1" "$2"; }
account_dir() { echo "$(provider_root "$P_ID")/$1"; } # name
set_active() { echo "$1" > "$(provider_active_file "$P_ID")"; } # name

# --- custom provider config (~/.config/swapkin/providers.json) ---
custom_config_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/swapkin/providers.json"; }

custom_config_safe() {
  local f; f=$(custom_config_file)
  [[ -f $f ]] || return 1
  # -L: follow a symlink (stow-style dotfiles) and check its TARGET's owner
  # and mode, not the link itself (L8) — otherwise a legitimate symlinked
  # config is always refused, with the misleading "world-writable" reason.
  local owner; owner=$(stat -L -c %U "$f" 2>/dev/null) || return 1
  if [[ $owner != "$(id -un)" ]]; then
    echo "swapkin: ignoring $f (not owned by you)" >&2
    return 1
  fi
  local perm; perm=$(stat -L -c %a "$f" 2>/dev/null) || return 1
  if (( (8#$perm) & 8#022 )); then
    echo "swapkin: ignoring $f (group- or world-writable)" >&2
    return 1
  fi
  return 0
}

custom_ids() {
  custom_config_safe || return 0
  jq -r '.providers[]?.id // empty' "$(custom_config_file)" 2>/dev/null
}

custom_entry() { # id
  custom_config_safe || return 0
  # L3: a config with a duplicated id must yield exactly one entry (the
  # first), not one per match glued together into invalid JSON.
  jq -c --arg id "$1" '[.providers[]? | select(.id==$id)][0] // empty' "$(custom_config_file)" 2>/dev/null
}

BUILTIN_IDS=(claude codex copilot)

all_provider_ids() {
  local id seen=()
  printf '%s\n' "${BUILTIN_IDS[@]}"
  for id in $(custom_ids); do
    valid_provider_id "$id" || continue
    if [[ " ${BUILTIN_IDS[*]} " == *" $id "* ]]; then
      echo "swapkin: ignoring custom provider '$id' (clashes with a built-in)" >&2
      continue
    fi
    # L3: a duplicated id in the config is listed once (the first wins).
    if [[ " ${seen[*]} " == *" $id "* ]]; then
      echo "swapkin: ignoring duplicate custom provider id '$id'" >&2
      continue
    fi
    seen+=("$id")
    echo "$id"
  done
}

# --- load one provider's adapter into this process (contract functions p_*) ---
load_adapter() { # id
  local id="$1"
  case "$id" in
    claude|codex|copilot)
      # shellcheck source=/dev/null
      source "$PROVIDERS_DIR/$id.sh"
      ;;
    *)
      valid_provider_id "$id" || return 1
      local entry; entry=$(custom_entry "$id")
      [[ -n $entry ]] || return 1
      _CUSTOM_ENTRY="$entry"
      P_ID="$id"
      P_NAME=$(jq -r '.name // .id' <<<"$entry")
      P_MODE=$(jq -r '.mode' <<<"$entry")
      P_CMD=$(jq -r '.command' <<<"$entry")
      P_MARKER="custom.json"
      P_STORE=$(jq -r 'if .mode=="hot" then (.loginFiles // [] | join(", ")) else (.homeEnv // "") end' <<<"$entry")
      P_HOMEVAR=$(jq -r 'if .mode=="cold" then (.homeEnv // "") else "" end' <<<"$entry")
      # L1: homeEnv reaches `export $HOMEVAR=...` inside `eval "$(swapkin env)"`
      # in every shell rc, so a bad value is a shell injection, not just a
      # bad variable name. Require a normal env-var name and refuse the ones
      # that would change how every later command in that shell runs.
      if [[ -n $P_HOMEVAR ]]; then
        if [[ ! $P_HOMEVAR =~ ^[A-Z_][A-Z0-9_]*$ ]] || [[ $P_HOMEVAR =~ ^(PATH|LD_PRELOAD|LD_LIBRARY_PATH|BASH_ENV|IFS|ENV|SHELL)$ ]]; then
          echo "swapkin: ignoring custom provider '$id' (unsafe homeEnv '$P_HOMEVAR')" >&2
          return 1
        fi
      fi
      P_HOW="Configured in providers.json."
      P_ADD_HINT="Run add, then sign in with $P_CMD when it asks."
      # shellcheck source=/dev/null
      source "$PROVIDERS_DIR/custom.sh"
      ;;
  esac
}

# --- demo mode: serve everything from demo/providers.json, touch nothing real ---
demo_flag_file() { echo "${XDG_CONFIG_HOME:-$HOME/.config}/swapkin/demo"; }
demo_active() {
  [[ ${SWAPKIN_DEMO:-0} == 1 ]] && return 0
  [[ -f "$(demo_flag_file)" ]]
}
demo_file() { echo "${SWAPKIN_DEMO_FILE:-$REPO_ROOT/demo/providers.json}"; }

demo_providers_json() {
  local f; f=$(demo_file)
  [[ -f $f ]] || { echo '{"demo":true,"providers":[]}'; return; }
  # A monthly quota resets on the 1st at 00:00 UTC, so it gets a real date
  # instead of an offset that would land at a random hour.
  jq --argjson now "$(date -u +%s)" --arg nextMonth "$(date -u -d "$(date -u +%Y-%m-01) +1 month" +%Y-%m-01T00:00:00Z)" '
    def toIso(mins): ($now + (mins*60)) | todate;
    .demo = true
    | .providers |= map(.accounts |= map(
        .limits |= (map(if has("resetsInMin") then (.resetsAt = toIso(.resetsInMin) | del(.resetsInMin))
                         elif .resetsAt == "next-month" then (.resetsAt = $nextMonth) else . end))
      ))
  ' "$f"
}

demo_list_json() { # provider id
  demo_providers_json | jq -c --arg id "$1" '(.providers[] | select(.id==$id) | .accounts) // []'
}

# The demo provider's active account, as name/plan/colour (each empty if none).
demo_active_account() { # id
  demo_providers_json | jq -r --arg id "$1" \
    '(.providers[] | select(.id==$id) | .accounts[] | select(.active)) as $a
     | [$a.name // "", $a.plan // "", $a.colour // ""] | @tsv'
}

demo_status() { # provider id
  local name plan colour; IFS=$'\t' read -r name plan colour < <(demo_active_account "$1")
  [[ -n $name ]] || { echo "No accounts yet. Run: swapkin add <name>"; return; }
  printf '%s · %s\n' "$name" "${plan:-?}"
}

demo_statusline() { # provider id, --plain
  local name plan colour; IFS=$'\t' read -r name plan colour < <(demo_active_account "$1")
  [[ -n $name ]] || return 0
  colour="${colour:-#d97757}"
  if [[ "${2:-}" == --plain ]]; then printf '@%s' "$name"; return; fi
  printf '\033[38;2;%d;%d;%dm@%s\033[0m' "$((16#${colour:1:2}))" "$((16#${colour:3:2}))" "$((16#${colour:5:2}))" "$name"
}

demo_cost() { echo '{"today":null}'; }

# --- generic account commands, shared by every provider ---
# M5: is any running process holding this cold home open right now (its
# HOMEVAR=value entry in /proc/PID/environ)? Unreadable environ files (a
# process we don't own) are skipped, not treated as a match or an error.
home_in_use() { # var value
  local var="$1" value="$2" f
  for f in /proc/[0-9]*/environ; do
    [[ -r $f ]] || continue
    tr '\0' '\n' < "$f" 2>/dev/null | grep -qxF "$var=$value" && return 0
  done
  return 1
}

cmd_remove() { # name
  local name="$1" dir
  valid_name "$name"
  dir=$(account_dir "$name")
  [[ -d $dir ]] || die "no account named '$name'"
  [[ $(active) == "$name" ]] && die "'$name' is active; switch to another account first"
  if [[ $P_MODE == cold ]] && declare -F home_of >/dev/null && [[ -n ${P_HOMEVAR:-} ]]; then
    local home; home=$(home_of "$name")
    if [[ -n $home ]] && home_in_use "$P_HOMEVAR" "$home"; then
      die "'$name' is in use by a running $P_NAME session; close those sessions first"
    fi
  fi
  rm -rf "${dir:?}"
  echo "Removed '$name'."
}

acct_plan() { # name
  declare -F p_plan >/dev/null && p_plan "$1" 2>/dev/null || true
}

# An account's cached usage.json (or {}) and its age in seconds (or -1 if
# absent). A malformed or non-object usage.json (a bad provider probe, a
# half-written file) becomes {} here instead of reaching jq downstream, so
# `providers --json` / `list --json` always emit valid JSON.
usage_of() { # dir
  local dir="$1" raw
  if [[ -f $dir/usage.json ]]; then
    raw=$(jq -ce 'if type == "object" then . else empty end' "$dir/usage.json" 2>/dev/null) || raw='{}'
    printf '%s\n%s\n' "$raw" "$(( $(date +%s) - $(stat -c %Y "$dir/usage.json") ))"
  else
    printf '%s\n%s\n' '{}' -1
  fi
}

cmd_list() { # --json or empty
  local cur; cur=$(active)
  if [[ "${1:-}" == --json ]]; then
    local name rows=()
    for name in $(profiles); do
      local dir; dir=$(account_dir "$name")
      local usage age; { read -r usage; read -r age; } < <(usage_of "$dir")
      rows+=("$(jq -c -n --arg name "$name" --arg cur "$cur" --arg colour "$(colour_of "$name")" \
        --arg plan "$(acct_plan "$name")" --argjson age "$age" --argjson usage "$usage" \
        '{name: $name, plan: $plan, active: ($name == $cur), colour: $colour, age: $age}
         + $usage
         + {weekly: (($usage.limits // []) | map(select((.label // "") | ascii_downcase | test("week")))[0].percent // null)}')")
    done
    if (( ${#rows[@]} == 0 )); then echo '[]'; else printf '%s\n' "${rows[@]}" | jq -sc .; fi
    return
  fi
  for name in $(profiles); do
    local plan; plan=$(acct_plan "$name")
    printf '%s %s · %s\n' "$([[ $name == "$cur" ]] && echo '*' || echo ' ')" "$name" "${plan:-?}"
  done
}

# One provider's full entry for `providers --json`. Runs in a subshell so the
# adapter it sources cannot leak functions/vars into a sibling provider's turn.
provider_entry_json() { # id
  local id="$1"
  (
    load_adapter "$id" || exit 0
    local installed=false
    if declare -F p_installed >/dev/null && p_installed 2>/dev/null; then installed=true; fi
    local has_accounts=""
    has_accounts=$(profiles | head -1)
    [[ $installed == true || -n $has_accounts ]] || exit 0

    local sessions=0
    declare -F p_sessions >/dev/null && sessions=$(p_sessions 2>/dev/null || echo 0)
    [[ $sessions =~ ^[0-9]+$ ]] || sessions=0

    local mode_label mode_words
    case "$P_MODE" in
      hot) mode_label="next message"; mode_words="Open sessions use the new account on their next message." ;;
      cold) mode_label="new sessions"; mode_words="Open sessions keep the old account. New sessions use the new one." ;;
      *) mode_label="re-login"; mode_words="The tool keeps one login. Switching means signing in again." ;;
    esac

    local cur name accounts
    cur=$(active)
    accounts="[]"
    for name in $(profiles); do
      local dir; dir=$(account_dir "$name")
      local usage age; { read -r usage; read -r age; } < <(usage_of "$dir")
      accounts=$(jq -c -n --argjson accs "$accounts" --arg name "$name" --arg cur "$cur" \
        --arg colour "$(colour_of "$name")" --arg plan "$(acct_plan "$name")" --argjson age "$age" --argjson usage "$usage" \
        '$accs + [{name:$name, active: ($name == $cur), colour: $colour, plan: $plan, age: $age,
                    limits: (($usage.limits) // []), counts: (($usage.counts) // []), note: (($usage.note) // ""),
                    tierLabel: (($usage.tierLabel) // ""), updatedAt: (($usage.updatedAt) // "")}
                   + {weekly: ((($usage.limits) // []) | map(select((.label // "") | ascii_downcase | test("week")))[0].percent // null)}]')
    done

    jq -n --arg id "$P_ID" --arg name "$P_NAME" --arg mode "$P_MODE" --arg modeLabel "$mode_label" \
      --arg modeWords "$mode_words" --arg store "$P_STORE" --arg how "$P_HOW" --arg addHint "$P_ADD_HINT" \
      --argjson installed "$installed" --argjson sessions "$sessions" --argjson accounts "$accounts" \
      '{id:$id, name:$name, mode:$mode, modeLabel:$modeLabel, modeWords:$modeWords, store:$store, how:$how,
        addHint:$addHint, installed:$installed, sessions:$sessions, accounts:$accounts}'
  )
}

cmd_providers_json() {
  local id entries=()
  for id in $(all_provider_ids); do
    local e; e=$(provider_entry_json "$id")
    [[ -n $e ]] && entries+=("$e")
  done
  if (( ${#entries[@]} == 0 )); then
    echo '{"demo":false,"providers":[]}'
  else
    printf '%s\n' "${entries[@]}" | jq -sc '{demo:false, providers:.}'
  fi
}

cmd_usage() { # single provider, adapter already loaded
  if [[ $P_MODE == hot ]] && declare -F p_save >/dev/null && [[ -n $(active) ]]; then
    ( exec 9>"$ACCOUNTS/.lock"; flock -w 5 9 || exit 0; p_save ) || true
  fi
  declare -F p_probe >/dev/null || return 0
  local name
  for name in $(profiles); do
    p_probe "$name" &
  done
  wait
}

cmd_usage_all() {
  local self id
  self="$(readlink -f "$0")"
  for id in $(all_provider_ids); do
    ( "$self" -p "$id" usage ) &
  done
  wait
}

cmd_env() { # [id]
  local id="${1:-}"
  if [[ -n $id ]]; then
    load_adapter "$id" || die "unknown provider '$id'"
    _print_env_for_active
    return
  fi
  local self pid
  self="$(readlink -f "$0")"
  for pid in $(all_provider_ids); do
    ( "$self" -p "$pid" env "$pid" 2>/dev/null ) || true
  done
}

_print_env_for_active() {
  [[ $P_MODE == cold ]] || return 0
  declare -F p_env >/dev/null || return 0
  local name; name=$(active)
  [[ -n $name ]] || return 0
  local k v
  while IFS='=' read -r k v; do
    [[ -n $k ]] && printf 'export %s=%q\n' "$k" "$v"
  done < <(p_env "$name")
}

cmd_run() { # id [args...]
  local id="$1"; shift || true
  load_adapter "$id" || die "unknown provider '$id'"
  local cli; cli=$(tool_bin "$P_CMD")
  [[ -n $cli ]] || die "cannot find the $P_CMD command"
  if [[ $P_MODE == cold ]] && declare -F p_env >/dev/null; then
    local name k v; name=$(active)
    if [[ -n $name ]]; then
      while IFS='=' read -r k v; do
        [[ -n $k ]] && export "$k=$v"
      done < <(p_env "$name")
    fi
  fi
  exec "$cli" "$@"
}

help() {
  cat <<'EOF'
Usage: swapkin [-p|--provider ID] <command>

  status          Show the active account
  list [--json]   List saved accounts (* marks the active one)
  add [name]      Save a new account (the first one is your current login)
  colour <name> <#rrggbb>
                  Set the colour that marks this account
  use <name>      Switch every session for this provider to <name>
  remove <name>   Forget a saved account
  save            Store the live login back into the active account (hot only)
  usage           Refresh rate limits; with no -p, probes every provider
  check           One watchdog pass for Claude: refresh, warn, hand over when spent
  cost            Today's tokens priced at API rates (an estimate, as JSON)
  statusline      The active account, coloured, for a status line
  providers --json
                  Every provider, installed or with saved accounts, as JSON
  env [id]        export KEY=value lines for a cold provider's active account
  run <id> [-- args]
                  Exec that provider's CLI with its active account's env
  demo on|off     Toggle demo mode (serves invented data, changes nothing real)

Provider: -p/--provider ID or SWAPKIN_PROVIDER (default: claude)
EOF
}

mkdir -p "$ACCOUNTS"

# --- parse -p/--provider, but only as a LEADING option before the subcommand ---
# Once the subcommand word (or `--`) is reached, everything after it is the
# child command's own arguments and must pass through untouched — otherwise
# `swapkin run codex -- -p myprofile exec hi` would swallow Codex's own -p.
explicit_provider=0
provider="${SWAPKIN_PROVIDER:-claude}"
[[ -n ${SWAPKIN_PROVIDER:-} ]] && explicit_provider=1
args=()
while (( $# )); do
  case "$1" in
    -p|--provider) provider="${2:?usage: -p <provider>}"; explicit_provider=1; shift 2 ;;
    --provider=*) provider="${1#--provider=}"; explicit_provider=1; shift ;;
    --) args+=("$@"); break ;;
    *) args+=("$@"); break ;;
  esac
done
if (( ${#args[@]} )); then set -- "${args[@]}"; else set -- status; fi
cmd="${1:-status}"

# --- demo mode: read commands answer from demo data, write/network commands no-op ---
if demo_active; then
  case "$cmd" in
    providers)
      [[ ${2:-} == --json ]] && { demo_providers_json; exit 0; } ;;
    list)
      if [[ ${2:-} == --json ]]; then demo_list_json "$provider"; else
        demo_list_json "$provider" | jq -r '.[] | ([.name," ","·",.plan] | join(" "))'
      fi
      exit 0 ;;
    status) demo_status "$provider"; exit 0 ;;
    statusline) demo_statusline "$provider" "${2:-}"; exit 0 ;;
    cost) demo_cost; exit 0 ;;
    use|save|add|remove|colour|color|usage|check|env|run)
      # stderr, not stdout: `env`'s output is meant for `eval "$(swapkin env)"`
      # in a shell rc, and this message would otherwise break that eval (L7).
      echo "swapkin: demo mode, nothing changed" >&2
      exit 0 ;;
  esac
fi

case "$cmd" in
  use|save|add|remove|colour|color)
    load_adapter "$provider" || die "unknown provider '$provider'"
    mkdir -p "$(provider_root "$P_ID")"
    exec 9>"$ACCOUNTS/.lock"
    flock -w 10 9 || die "another switch is still running"
    case "$cmd" in
      use) valid_name "${2:?usage: swapkin use <name>}"; declare -F p_use >/dev/null || die "use is not supported for $provider"
           # A provider can set P_ALWAYS_SWITCH=1 to skip the "already on"
           # short-circuit: copilot's use must always run gh auth switch
           # (idempotent), since the stored pointer can disagree with gh's
           # real active login (M9).
           if [[ ${P_ALWAYS_SWITCH:-0} != 1 && $(active) == "$2" ]]; then echo "Already on $2"; else p_use "$2"; fi ;;
      add) declare -F p_add >/dev/null || die "add is not supported for $provider"; p_add "${2:-}" "${3:-}" ;;
      colour|color) set_colour "${2:?usage: swapkin colour <name> <#rrggbb>}" "${3:?usage: swapkin colour <name> <#rrggbb>}" ;;
      remove) cmd_remove "${2:?usage: swapkin remove <name>}" ;;
      save) declare -F p_save >/dev/null && p_save || die "save is not supported for $provider" ;;
    esac ;;
  status)
    load_adapter "$provider" || die "unknown provider '$provider'"
    if declare -F p_status >/dev/null; then p_status; else
      name=$(active)
      [[ -n $name ]] || { echo "No accounts yet. Run: swapkin add <name>"; exit 0; }
      printf '%s · %s\n' "$name" "$(acct_plan "$name")"
    fi ;;
  list)
    load_adapter "$provider" || die "unknown provider '$provider'"
    cmd_list "${2:-}" ;;
  usage)
    if (( ! explicit_provider )); then
      cmd_usage_all
    else
      load_adapter "$provider" || die "unknown provider '$provider'"
      mkdir -p "$(provider_root "$P_ID")"
      cmd_usage
    fi ;;
  check)
    load_adapter claude
    claude_check ;;
  cost)
    load_adapter "$provider" || die "unknown provider '$provider'"
    if declare -F p_cost >/dev/null; then p_cost; else echo '{"today":null}'; fi ;;
  statusline)
    load_adapter "$provider" || die "unknown provider '$provider'"
    declare -F p_statusline >/dev/null && p_statusline "${2:-}" ;;
  providers)
    [[ ${2:-} == --json ]] || { help >&2; exit 2; }
    cmd_providers_json ;;
  env) cmd_env "${2:-}" ;;
  run)
    shift || true
    run_id="${1:?usage: swapkin run <id> [-- args]}"; shift || true
    [[ ${1:-} == -- ]] && shift
    cmd_run "$run_id" "$@" ;;
  demo)
    case "${2:-}" in
      on) mkdir -p "$(dirname "$(demo_flag_file)")"; touch "$(demo_flag_file)"; echo "Demo mode on." ;;
      off) rm -f "$(demo_flag_file)"; echo "Demo mode off." ;;
      *) die "usage: swapkin demo on|off" ;;
    esac ;;
  -h|--help|help) help ;;
  *) help >&2; exit 2 ;;
esac
